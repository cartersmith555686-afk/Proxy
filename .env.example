# ---- Required in production ----
# Long random string used to sign login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me

# ---- Storage (accounts + saved settings) ----
# On Render's free plan the filesystem is wiped on every deploy/spin-down, so accounts
# don't persist. On a paid plan, attach a disk (e.g. mounted at /var/data) and set
# DATA_DIR=/var/data.
DATA_DIR=./data

# ---- AI (any OpenAI-compatible /chat/completions endpoint) ----
# Default is a free, keyless endpoint. Swap for Groq / OpenRouter / Ollama etc.
AI_BASE_URL=https://text.pollinations.ai/openai
AI_API_KEY=
AI_MODEL=openai
# Comma-separated list users can pick from in Settings (optional)
AI_MODELS=openai
# Extra instructions added to every AI conversation (optional)
AI_SYSTEM=

# ---- Proxy hardening (optional) ----
# Comma-separated DNS servers the proxy uses to resolve sites, e.g. 1.1.1.1,1.0.0.1
WISP_DNS=

# ---- Chat (optional) ----
# Comma-separated words that get masked in chat
CHAT_BLOCKLIST=

PORT=3000
